# Copy this file to .env.local and replace only the values you use.
# Never commit .env.local or real credentials.

# Required: website scraping (https://firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Sandbox provider: e2b or vercel
SANDBOX_PROVIDER=e2b

# Option A: E2B (https://e2b.dev)
E2B_API_KEY=your_e2b_api_key

# Option B: Vercel Sandbox
# Run `vercel link` and `vercel env pull` to obtain an OIDC token, or configure
# all three personal-token fields below. Do not enable both authentication modes.
# VERCEL_OIDC_TOKEN=your_vercel_oidc_token
# VERCEL_TEAM_ID=your_vercel_team_id
# VERCEL_PROJECT_ID=your_vercel_project_id
# VERCEL_TOKEN=your_vercel_token

# AI provider: configure at least one provider used by NEXT_PUBLIC_DEFAULT_MODEL.
# Vercel AI Gateway can replace the individual provider keys.
# AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# OpenAI or an OpenAI-compatible provider
OPENAI_API_KEY=your_openai_or_provider_key
OPENAI_BASE_URL=https://your-provider.example/v1
# Use "chat" only when the provider supports Chat Completions but not Responses.
OPENAI_API_MODE=chat

# Optional alternative providers
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GROQ_API_KEY=your_groq_api_key
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# The model ID must exist at the selected provider.
NEXT_PUBLIC_DEFAULT_MODEL=openai/gpt-5.6-sol

# Optional: public app origin used by server-to-server API calls.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Morph Fast Apply (https://morphllm.com)
# MORPH_API_KEY=your_morph_api_key
